{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>particify/dev/devops/renovate-dependency-bot//presets/default"
  ],
  "baseBranchPatterns": ["master", "3.13"],
  "packageRules": [
    {
      "matchPackageNames": [
        "ng-packagr",
        "typescript",
        "@angular/{/,}**",
        "@angular-devkit/{/,}**"
      ],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "jasmine 6.x is the final version supporting Karma and zone.js",
      "matchPackageNames": ["@types/jasmine", "jasmine-core"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "ng-packagr",
        "typescript",
        "@angular/{/,}**",
        "@angular-devkit/{/,}**"
      ],
      "minimumReleaseAge": "0 days"
    },
    {
      "extends": ["schedule:monthly"],
      "matchPackageNames": ["eslint-plugin-jsdoc"]
    },
    {
      "groupName": "analog",
      "matchPackageNames": ["@analogjs/{/,}**"]
    },
    {
      "groupName": "angular",
      "matchPackageNames": [
        "ng-packagr",
        "@angular/{/,}**",
        "@angular-devkit/{/,}**"
      ]
    },
    {
      "groupName": "apollo",
      "matchPackageNames": ["@apollo/{/,}**"]
    },
    {
      "groupName": "eslint",
      "matchPackageNames": [
        "eslint",
        "typescript-eslint",
        "@angular-eslint/{/,}**",
        "@eslint/{/,}**",
        "@typescript-eslint/{/,}**",
        "eslint-{/,}**"
      ]
    },
    {
      "groupName": "graphql-codegen",
      "matchPackageNames": ["@graphql-codegen/{/,}**"]
    },
    {
      "groupName": "stomp",
      "matchPackageNames": ["@stomp/{/,}**", "uuid"]
    },
    {
      "groupName": "stylelint",
      "matchPackageNames": [
        "postcss",
        "stylelint",
        "stylelint-config-standard-scss"
      ]
    }
  ]
}

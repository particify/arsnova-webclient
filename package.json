    "@angular/core": "22.3.0",
    "@angular/flex-layout": "15.0.0-beta.42",
    "@angular/forms": "22.3.0",
    "@angular/material": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@angular/platform-browser-dynamic": "22.3.0",
    "@angular/router": "22.3.0",
    "@angular/service-worker": "22.3.0",
    "@fontsource/material-symbols-outlined": "5.3.9",
    "@fontsource/roboto": "5.3.0",
    "@jsverse/transloco": "8.4.0",
    "@stomp/rx-stomp": "2.4.0",
    "@stomp/stompjs": "7.5.0",
    "angular-material-css-vars": "11.0.0",
    "backoff-rxjs": "7.0.0",
    "chart.js": "4.6.1",
    "chartjs-plugin-datalabels": "2.2.0",
    "d3-cloud": "1.2.9",
    "dayjs": "1.11.23",
